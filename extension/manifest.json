{
  "manifest_version": 3,
  "name": "FocusFlow Capture",
  "version": "1.0.0",
  "description": "Capture events from Meetup and Luma directly into FocusFlow",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.meetup.com/*",
    "https://lu.ma/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.meetup.com/*/events/*",
        "https://lu.ma/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
