// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum EventSource {
  MANUAL
  MEETUP
  LUMA
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum ReminderMethod {
  PUSH
  EMAIL
}

// ─── Models ──────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  googleTokens Json?    // Store Google OAuth tokens for future Calendar sync
  apiKey       String?  @unique @default(cuid()) // API key for extension auth
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events Event[]
  tasks  Task[]

  @@map("users")
}

model Event {
  id          String      @id @default(cuid())
  userId      String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  location    String?
  source      EventSource @default(MANUAL)
  sourceUrl   String?
  color       String?     @default("#6366f1") // Default indigo color
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders Reminder[]

  @@index([userId, startTime])
  @@map("events")
}

model Task {
  id        String     @id @default(cuid())
  userId    String
  title     String
  dueDate   DateTime?
  priority  Priority   @default(MEDIUM)
  status    TaskStatus @default(TODO)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders Reminder[]

  @@index([userId, status])
  @@index([userId, priority])
  @@map("tasks")
}

model Reminder {
  id                   String         @id @default(cuid())
  eventId              String?
  taskId               String?
  triggerOffsetMinutes Int            @default(15) // Minutes before the event/task due date
  method               ReminderMethod @default(PUSH)
  sent                 Boolean        @default(false)
  triggerAt             DateTime      // Pre-computed trigger time for efficient querying
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  task  Task?  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([sent, triggerAt])
  @@map("reminders")
}
